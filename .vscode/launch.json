    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug local train",
            "type": "debugpy",
            "request": "launch",
            "program": "src/train.py",
            "console": "integratedTerminal",
            "args": [
                "--prefix",
                "ssdlite-no-transroms-trainable-backbone-0-640-640-1-2",
                "--epochs",
                "100",
                "--rounds",
                "2",
                "--samples-per-image",
                "20",
                "--trainable-backbone-layers",
                "6",
                "--batch-size",
                "24",
                "--comment",
                "'Scale 0.5-1.5, Rotate 360, 3 trainable layers'"
            ]
        },
        {
            "name": "Debug local inference",
            "type": "debugpy",
            "request": "launch",
            "program": "src/run_inference.py",
            "console": "integratedTerminal",
            "args": [
                "--prefix",
                "infer"
            ]
        },
        {
            "name": "Debug aws train",
            "type": "debugpy",
            "request": "launch",
            "program": "aws-train.py",
            "console": "integratedTerminal",
            "args": [
                "--prefix",
                "object-detection",
                "--job-name",
                "ssdlite-640-640",
                "--epochs",
                "100",
                "--rounds",
                "3",
                "--samples-per-image",
                "50",
                "--trainable-backbone-layers",
                "0",
                "--batch-size",
                "64",
                "--lr",
                "0.004",
                "--comment",
                "'3 Round, 100 epochs, lr 0.005, batch 512, seed 0'"
            ]
        }
    ]
